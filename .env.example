# Copy to .env.local (gitignored) for `npm run dev`, and add the same keys in Vercel → Settings → Environment Variables.
# From the Google Cloud service account's JSON key:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendar the cuts are written to (usually your Gmail address). Share it with the service account: "Make changes to events".
GOOGLE_CALENDAR_ID=
# Optional, comma separated: other calendars that block times (classes, work). Share each with the service account.
GOOGLE_BUSY_CALENDARS=
# Password for /admin
ADMIN_PASSWORD=
